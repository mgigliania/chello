# All optional. By default each person enters their own key in Settings, and
# the two free providers cost nobody anything.
#
# Set one of these only if you want to pay for everyone who opens your link.
# Anyone with the URL can then use your allowance, so treat it as private.

# Free tier, no card required — the app's default.
GOOGLE_API_KEY=

# Free tier, and the fastest of the three.
GROQ_API_KEY=

# Free tier, one key for many models — the roster rotates, so the app asks
# OpenRouter what is free today rather than assuming.
OPENROUTER_API_KEY=

# Paid, and the best teacher of the four.
ANTHROPIC_API_KEY=
